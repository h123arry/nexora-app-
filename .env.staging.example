# Owner-provided staging values. Never commit the real staging file or credentials.
NEXORA_ENV=staging
NODE_ENV=staging
RELEASE_VERSION=<commit-sha-or-release-id>
NEXORA_STAGING_PROJECT_ID=<firebase-staging-project-id>
GCLOUD_PROJECT=<firebase-staging-project-id>
FIRESTORE_DATABASE_ID=<staging-named-database-id>
FIREBASE_STORAGE_BUCKET=<staging-project-id>.firebasestorage.app
STAGING_APP_URL=https://<staging-hostname>

# Required public Firebase Web App configuration from the staging project.
VITE_NEXORA_ENV=staging
VITE_FIREBASE_PROJECT_ID=<firebase-staging-project-id>
VITE_FIREBASE_APP_ID=<staging-web-app-id>
VITE_FIREBASE_API_KEY=<staging-web-api-key>
VITE_FIREBASE_AUTH_DOMAIN=<firebase-staging-project-id>.firebaseapp.com
VITE_FIREBASE_DATABASE_ID=<staging-named-database-id>
VITE_FIREBASE_STORAGE_BUCKET=<staging-project-id>.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=<staging-messaging-sender-id>
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=<staging-web-push-vapid-key-if-used>
VITE_FIREBASE_APPCHECK_SITE_KEY=<staging-recaptcha-enterprise-site-key-if-enabled>

# Optional server-side provider configuration; leave unset unless deliberately enabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
APP_URL=https://<staging-hostname>
