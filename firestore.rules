rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function chatMember(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }
    function publicProfileKeys() {
      return [
        'id', 'username', 'name', 'avatar', 'bio', 'location', 'website',
        'followers', 'following', 'sparks', 'isVerified', 'hasStory',
        'coverImage', 'joinedDate', 'reputationPoints', 'reputationBreakdown',
        'interestDNA', 'skills', 'statusText', 'statusEmoji', 'pinnedMusicSong',
        'pinnedMusicArtist', 'pinnedMusicUrl', 'pinnedPosts'
      ];
    }
    function editableProfileKeys() {
      return [
        'username', 'name', 'avatar', 'bio', 'location', 'website', 'coverImage',
        'interestDNA', 'skills', 'statusText', 'statusEmoji', 'pinnedMusicSong',
        'pinnedMusicArtist', 'pinnedMusicUrl', 'pinnedPosts'
      ];
    }
    function isOwnCommentAppend(postId) {
      let oldComments = resource.data.get('comments', []);
      let newComments = request.resource.data.get('comments', []);
      let addedComment = newComments[oldComments.size()];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'commentsCount'])
        && oldComments is list
        && newComments is list
        && newComments.size() == oldComments.size() + 1
        && newComments.hasAll(oldComments)
        && request.resource.data.get('commentsCount', 0) == resource.data.get('commentsCount', 0) + 1
        && addedComment.userId == request.auth.uid
        && addedComment.postId == postId
        && addedComment.content is string
        && addedComment.keys().hasOnly(['id', 'postId', 'userId', 'username', 'name', 'avatar', 'content', 'timestamp', 'likes']);
    }

    // Default-deny for every path not explicitly listed below.
    match /{document=**} { allow read, write: if false; }

    // Mail and security logs are trusted-server-only: clients cannot forge recipients or audit events.
    match /mail/{mailId} {
      allow read: if false;
      allow create: if signedIn()
        && request.auth.token.email is string
        && request.resource.data.to is list
        && request.resource.data.to.size() == 1
        && request.resource.data.to[0] == request.auth.token.email;
      allow update, delete: if false;
    }
    match /users/{userId}/securityLogs/{logId} {
      allow read: if owner(userId);
      allow create, update, delete: if false;
    }

    // Full account records (including email, role, moderation state, and other private fields) are owner-only.
    match /users/{userId} {
      allow get: if owner(userId);
      allow list: if false;
      allow create: if owner(userId)
        && request.resource.data.id == userId
        && request.resource.data.keys().hasOnly([
          'id', 'username', 'name', 'avatar', 'bio', 'location', 'website',
          'followers', 'following', 'sparks', 'isVerified', 'hasStory', 'coverImage',
          'joinedDate', 'email', 'phone', 'role', 'isBanned', 'isSuspended',
          'isSeedProfile', 'preferredLanguage', 'savedCollections', 'contributions',
          'reputationPoints', 'reputationBreakdown', 'interestDNA', 'skills',
          'nexBalance', 'totalEarnedNex', 'pendingNex', 'thisWeekEarnedNex',
          'thisMonthEarnedNex', 'thisYearEarnedNex', 'creatorModeEnabled',
          'statusText', 'statusEmoji', 'pinnedMusicSong', 'pinnedMusicArtist',
          'pinnedMusicUrl', 'pinnedPosts', 'achievements', 'lastUsernameChangeTime',
          'lastDisplayNameChangeTime', 'createdAt', 'updatedAt'
        ])
        && !request.resource.data.keys().hasAny(['role', 'isBanned', 'isSuspended', 'nexBalance', 'totalEarnedNex', 'pendingNex'])
        && (!request.resource.data.keys().hasAny(['email'])
          || request.resource.data.email == request.auth.token.get('email', '')
          || request.auth.token.get('phone_number_verified', false))
        && request.resource.data.isVerified == (request.auth.token.get('email_verified', false) || request.auth.token.get('phone_number_verified', false));
      allow update: if owner(userId)
        && request.resource.data.id == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'username', 'name', 'avatar', 'bio', 'location', 'website', 'coverImage',
          'interestDNA', 'skills', 'statusText', 'statusEmoji', 'pinnedMusicSong',
          'pinnedMusicArtist', 'pinnedMusicUrl', 'pinnedPosts', 'preferredLanguage',
          'savedCollections', 'updatedAt', 'isVerified'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified'])
          || request.resource.data.isVerified == request.auth.token.get('email_verified', false)
          || request.resource.data.isVerified == request.auth.token.get('phone_number_verified', false));
      allow delete: if false;

      match /memoryEvents/{eventId} { allow read, write: if owner(userId); }
      match /memoryState/{stateId} { allow read, write: if owner(userId); }
      match /settings/{settingId} { allow read, write: if owner(userId); }
      match /notifications/{notifId} {
        allow read, list, delete: if owner(userId);
        allow create: if false;
        allow update: if owner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      }
      match /activityEvents/{eventId} { allow read, write: if owner(userId); }
    }

    // Public directory contains an allowlisted projection, never private account fields.
    match /publicProfiles/{userId} {
      allow get, list: if true;
      allow create: if owner(userId)
        && request.resource.data.id == userId
        && request.resource.data.keys().hasOnly(publicProfileKeys());
      allow update: if owner(userId)
        && request.resource.data.id == userId
        && request.resource.data.keys().hasOnly(publicProfileKeys())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(editableProfileKeys().concat(['isVerified']))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified'])
          || request.resource.data.isVerified == request.auth.token.get('email_verified', false)
          || request.resource.data.isVerified == request.auth.token.get('phone_number_verified', false));
      allow delete: if false;
    }

    // Posts are public, but authorship cannot be forged or transferred by the client.
    match /posts/{postId} {
      allow get, list: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && (!request.resource.data.keys().hasAny(['authorId']) || request.resource.data.authorId == request.auth.uid)
        && (!request.resource.data.keys().hasAny(['isVerified'])
          || !request.resource.data.isVerified
          || request.auth.token.get('email_verified', false)
          || request.auth.token.get('phone_number_verified', false))
        && request.resource.data.get('likes', 0) == 0
        && request.resource.data.get('commentsCount', 0) == 0
        && request.resource.data.get('shares', 0) == 0
        && request.resource.data.get('views', 0) == 0
        && request.resource.data.get('saves', 0) == 0;
      allow update: if signedIn()
        && ((resource.data.userId == request.auth.uid || resource.data.authorId == request.auth.uid)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'content', 'image', 'images', 'imageFilter', 'imageFilters', 'videoUrl',
          'voiceTranscript', 'voiceAudioUrl', 'tags',
          'commentsDisabled', 'location', 'audience', 'communityName', 'opportunityType',
          'interactivePoll', 'editHistory', 'scheduledTime', 'isDraft', 'isArchived',
          'discussionModeEnabled', 'discussionSideA', 'discussionSideB', 'updatedAt'
          ]) || isOwnCommentAppend(postId));
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.authorId == request.auth.uid);
    }

    match /drafts/{draftId} {
      allow get, list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Stories are public text updates. Identity comes from the owner's public profile;
    // clients cannot write view counts or extend a story beyond its 24-hour lifetime.
    match /stories/{storyId} {
      allow get, list: if signedIn() && resource.data.privacy == 'everyone';
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'id', 'userId', 'name', 'username', 'avatar', 'caption',
          'mediaType', 'privacy', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.id == storyId
        && request.resource.data.userId == request.auth.uid
        && exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
        && request.resource.data.name == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.name
        && request.resource.data.username == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.username
        && request.resource.data.avatar == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.avatar
        && request.resource.data.caption is string
        && request.resource.data.caption.size() > 0
        && request.resource.data.caption.size() <= 500
        && request.resource.data.mediaType == 'text'
        && request.resource.data.privacy == 'everyone'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h');
      allow update: if false;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /follows/{followId} {
      allow get, list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.followerId == request.auth.uid;
    }

    match /activities/{activityId} {
      allow get, list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    match /notifications/{notificationId} {
      allow get, list: if signedIn() && resource.data.userId == request.auth.uid;
      // Recipient-facing notifications must be created by trusted backend code.
      allow create: if false;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /creatorAnalytics/{analyticsId} {
      allow get, list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /pages/{pageId} {
      allow get, list: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.id == pageId
        && request.resource.data.get('isVerified', false) == false;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.get('id', pageId) == pageId
        && request.resource.data.get('isVerified', false) == resource.data.get('isVerified', false);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /communities/{communityId} {
      allow get, list: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.id == communityId;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.get('id', communityId) == communityId;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /automationLogs/{logId} { allow read, write: if false; }

    match /moderationReports/{reportId} {
      allow get, list: if signedIn() && resource.data.reporterId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if false;
    }

    match /privacySettings/{userId} { allow read, write: if owner(userId); }

    // Chats can be discovered only by participant-filtered queries and read only by participants.
    match /chats/{chatId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 50
        && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastTimestamp', 'unreadCount', 'updatedAt']);
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow get, list: if chatMember(chatId);
        allow create: if chatMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.chatId == chatId;
        allow update: if chatMember(chatId)
          && resource.data.senderId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['delivered', 'read'];
        allow delete: if chatMember(chatId) && resource.data.senderId == request.auth.uid;
      }
      match /typing/{typingId} {
        allow read, list: if chatMember(chatId);
        allow create, update: if chatMember(chatId) && typingId == request.auth.uid
          && request.resource.data.keys().hasOnly(['state', 'updatedAt'])
          && request.resource.data.state in ['typing', 'recording', 'uploading', null];
        allow delete: if chatMember(chatId) && typingId == request.auth.uid;
      }
    }

    // Legacy root messages are not used by the current client; deny until migrated to participant-bound chats.
    match /messages/{messageId} { allow read, write: if false; }

    match /presence/{userId} {
      allow get: if owner(userId);
      allow list: if false;
      allow create, update: if owner(userId)
        && request.resource.data.keys().hasOnly(['isOnline', 'lastActive']);
      allow delete: if owner(userId);
    }
  }
}
