# Server runtime. Production startup requires the Firebase target and release ID below.
NODE_ENV=development
PORT=3000
RELEASE_VERSION=local
GCLOUD_PROJECT=nexora-prod-voiceharrison
FIRESTORE_DATABASE_ID=default
FIREBASE_STORAGE_BUCKET=nexora-prod-voiceharrison.appspot.com

# Optional Vite client overrides. If supplied, these must be copied from the
# same owner-registered Firebase Web App as firebase-applet-config.json.
VITE_FIREBASE_PROJECT_ID=nexora-prod-voiceharrison
VITE_FIREBASE_APP_ID=1:128918144717:web:8dc433e0a390388d3e0b84
VITE_FIREBASE_API_KEY=AIzaSyA8RyvP6crBpI4Zg_bgLJw3U9cJBMTQ-Gk
VITE_FIREBASE_AUTH_DOMAIN=nexora-prod-voiceharrison.firebaseapp.com
VITE_FIREBASE_DATABASE_ID=default
VITE_FIREBASE_STORAGE_BUCKET=nexora-prod-voiceharrison.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=128918144717

# GEMINI_API_KEY is server-only. Never expose it through a VITE_ variable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL=gemini-2.5-flash

# APP_URL: the URL where this app is hosted, if an integration needs it.
APP_URL="MY_APP_URL"

# Firebase Cloud Messaging VAPID Key for Web Push Notifications.
# This is public browser configuration, not a private credential.
VITE_FIREBASE_VAPID_KEY=BPE8Ex5XYXiWxSdT1Z4Yj_tXDjphbbEbgLJw3U9cJBMTQ-GkOhBK0cZFkd0K8NLBB-8kJ-2STey4Bf5zr7Ns12BQ

# Firebase App Check reCAPTCHA Enterprise site key.
# Set this in production after registering the deployed domain; leave empty for local development.
VITE_FIREBASE_APPCHECK_SITE_KEY=
