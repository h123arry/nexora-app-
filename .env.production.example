# Owner-provided production values. Keep the real file in the hosting secret manager.
NEXORA_ENV=production
NODE_ENV=production
RELEASE_VERSION=<immutable-release-id>
GCLOUD_PROJECT=nexora-prod-voiceharrison
FIRESTORE_DATABASE_ID=<owner-confirmed-production-database-id>
FIREBASE_STORAGE_BUCKET=<owner-confirmed-production-bucket>

# Required public Firebase Web App configuration from the production project.
VITE_NEXORA_ENV=production
VITE_FIREBASE_PROJECT_ID=nexora-prod-voiceharrison
VITE_FIREBASE_APP_ID=<owner-confirmed-production-web-app-id>
VITE_FIREBASE_API_KEY=<owner-confirmed-production-web-api-key>
VITE_FIREBASE_AUTH_DOMAIN=nexora-prod-voiceharrison.firebaseapp.com
VITE_FIREBASE_DATABASE_ID=<owner-confirmed-production-database-id>
VITE_FIREBASE_STORAGE_BUCKET=<owner-confirmed-production-bucket>
VITE_FIREBASE_MESSAGING_SENDER_ID=<owner-confirmed-production-messaging-sender-id>
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=<production-web-push-vapid-key-if-used>
VITE_FIREBASE_APPCHECK_SITE_KEY=<production-recaptcha-enterprise-site-key>

# Server-only secrets must come from the hosting secret manager.
GEMINI_API_KEY=<secret-manager-reference>
GEMINI_MODEL=gemini-2.5-flash
APP_URL=<production-https-url>
